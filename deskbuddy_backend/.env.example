# ============================================================
# Omnipect Backend Configuration (.env)
# Copy this file to .env and fill in your NVIDIA_API_KEY
# ============================================================

DEBUG=true
APP_NAME=Omnipect Backend
VERSION=1.0.0
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8080

# Local SQLite database (auto-created in deskbuddy_backend/data/app.db)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0

# ESP32 Serial Port (auto-detected if left as COM3/COM6)
SERIAL_PORT=COM6
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0
ENABLE_HARDWARE_BRIDGE=true
COMPANION_PUSH_INTERVAL=0.5

# ML Bearing Fault Model
ML_MODEL_PATH=models/cnn_model.pth

# Voice Assistant (NVIDIA NIM Nemotron + faster-whisper STT + edge-tts TTS)
# Get your free API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=en-US-ChristopherNeural
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024

# Feature Toggles
ENABLE_PC_MONITORING=true
ENABLE_MUSIC_CONTROL=true
ENABLE_CALENDAR=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_DESK_MATE=true

# Security & Logging
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
LOG_FORMAT=json
