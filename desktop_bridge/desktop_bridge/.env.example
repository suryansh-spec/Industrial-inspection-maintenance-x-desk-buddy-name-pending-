# Desktop Bridge Configuration
# Copy to .env and modify as needed

# Bridge Settings
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8080
BRIDGE_DEBUG=true

# Arduino/ESP32 Serial Connection
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0

# Backend API
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=30.0

# ML Pipeline
ML_MODEL_PATH=ml/signal_fault_classification_pipeline/signal-fault-classification/models/cnn_model.pth

# Nemotron Voice Assistant
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Audio (for future voice features)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024

# Desktop Tools
ENABLE_PC_MONITORING=true
ENABLE_MUSIC_CONTROL=true
ENABLE_CALENDAR=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_DESK_MATE=true

# DeskMate Settings
DESK_MATE_THEME=dark
DESK_MATE_WIDGET_POSITION=top-right
DESK_MATE_WIDGET_OPACITY=0.95
DESK_MATE_NOTIFICATIONS_ENABLED=true
DESK_MATE_HOTKEYS_ENABLED=true
DESK_MATE_START_MINIMIZED=false
DESK_MATE_AUTO_START_POMODORO=false

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Google Calendar (optional)
# GOOGLE_CREDENTIALS_PATH=~/.config/google-calendar/credentials.json
# GOOGLE_TOKEN_PATH=~/.config/google-calendar/token.json

# Outlook Calendar (optional)
# OUTLOOK_CLIENT_ID=your_client_id
# OUTLOOK_CLIENT_SECRET=your_client_secret
# OUTLOOK_TENANT_ID=your_tenant_id